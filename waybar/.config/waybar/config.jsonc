// -*- mode: jsonc -*-
[
  // ── Main monitor (DP-3) — workspaces 1-4 ────────────────────────────
  {
    "output": "DP-3",
    // "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 36, // Waybar height (to be removed for auto height)
    "margin-bottom": 18,
    "width": 1600, // Waybar width
    // Choose the order of the modules
    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
      "mpris",
      "pulseaudio",
      "network",
      "clock",
      "tray"
    ],
    "hyprland/workspaces": {
      "format": "{name}",
      "persistent-workspaces": {
        "DP-3": [1, 2, 3, 4]
      }
    },
    "mpris": {
      "format": "󰎈 {artist} - {title}",
      "format-paused": "󰏤 {artist} - {title}",
      "player": "chromium",
      "max-length": 25,
      "on-click": "playerctl -p chromium play-pause"
    },
    "tray": {
      // "icon-size": 21,
      "spacing": 10
    },
    "clock": {
      "format": "{:%d / %H:%M}",
      "tooltip-format": "{:%d %B}\n{calendar}",
      "format-alt": "{:%Y-%m-%d}"
    },
    "network": {
      // "interface": "wlp2*", // (Optional) To force the use of this interface
      "format-wifi": "({signalStrength}%) ",
      "format-ethernet": "{ipaddr} ",
      "tooltip-format": "{ifname} via {gwaddr} ",
      "format-linked": "{ifname} (No IP) ",
      "format-disconnected": "Disconnected ⚠",
      "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
      // "scroll-step": 1, // %, can be a float
      "format": "{volume}% {icon}",
      "format-bluetooth": "{volume}% {icon}",
      "format-bluetooth-muted": " {icon} {format_source}",
      "format-muted": " {format_source}",
      "format-source": "{volume}% ",
      "format-source-muted": "",
      "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": [
          "",
          "",
          ""
        ]
      },
      "on-click": "pavucontrol"
    }
  },

  // ── Vertical monitor (DP-2) — workspaces 5-7 ────────────────────────
  {
    "output": "DP-2",
    "position": "bottom",
    "height": 36,
    "margin-bottom": 18,
    "width": 950,
    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
      "clock",
      "tray"
    ],
    "hyprland/workspaces": {
      "format": "{name}",
      "persistent-workspaces": {
        "DP-2": [5, 6, 7]
      }
    },
    "tray": {
      "spacing": 10
    },
    "clock": {
      "format": "{:%d / %H:%M}",
      "tooltip-format": "{:%d %B}\n{calendar}",
      "format-alt": "{:%Y-%m-%d}"
    }
  }
]
