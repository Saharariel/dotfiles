# Sahar .zshrc config  (shared across all machines)
######################################

# p10k instant prompt
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# OS-specific setup (brew env, etc.) — must run early so `command -v brew` works below
case "$(uname -s)" in
  Darwin) [[ -f ~/.zshrc.darwin ]] && source ~/.zshrc.darwin ;;
  Linux)  [[ -f ~/.zshrc.linux ]]  && source ~/.zshrc.linux ;;
esac

######################################
# Plugin locations (resolved once)
######################################
# p10k + zsh plugins come from Homebrew on mac/Bazzite, and from git clones in
# dev containers (cloned by scripts/packages-debian.sh). Resolve every path here
# so the rest of the file just does `[[ -f $X ]] && source $X` — no per-site
# brew/clone branching. Brew wins when present.
if command -v brew &>/dev/null; then
  BREW_PREFIX=$(brew --prefix)
  fpath=($BREW_PREFIX/share/zsh/site-functions $fpath)
  P10K_THEME=$BREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme
  ZSH_AUTOSUGGESTIONS=$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  ZSH_SYNTAX_HIGHLIGHTING=$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  ZSH_VI_MODE=$BREW_PREFIX/opt/zsh-vi-mode/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh
else
  _zsh_data=${XDG_DATA_HOME:-$HOME/.local/share}
  P10K_THEME=$_zsh_data/powerlevel10k/powerlevel10k.zsh-theme
  ZSH_AUTOSUGGESTIONS=$_zsh_data/zsh-autosuggestions/zsh-autosuggestions.zsh
  ZSH_SYNTAX_HIGHLIGHTING=$_zsh_data/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  ZSH_VI_MODE=$_zsh_data/zsh-vi-mode/zsh-vi-mode.plugin.zsh
fi

######################################
# Completions
######################################
# Cache dir for completions generated by `tool completion zsh`. Generating these
# at every startup spawns a subprocess each time (slow); instead we write them to
# files once and let compinit pick them up from fpath.
ZCOMPCACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
[[ -d $ZCOMPCACHE ]] || mkdir -p $ZCOMPCACHE
fpath=(/usr/share/zsh/site-functions $ZCOMPCACHE $fpath)

[[ -f $P10K_THEME ]] && source $P10K_THEME

# Generate cached completions only if missing. Delete a file to refresh it,
# or run `rm -rf $ZCOMPCACHE` after upgrading tools.
command -v kubectl &>/dev/null && [[ ! -f $ZCOMPCACHE/_kubectl ]] && kubectl completion zsh > $ZCOMPCACHE/_kubectl
command -v flux    &>/dev/null && [[ ! -f $ZCOMPCACHE/_flux ]]    && flux completion zsh    > $ZCOMPCACHE/_flux

# compinit: only rebuild the dump once every 24h, otherwise load it fast (-C).
autoload -Uz compinit
_zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/.zcompdump"
if [[ -n $_zcompdump(#qN.mh+24) ]]; then
  compinit -d "$_zcompdump"
else
  compinit -C -d "$_zcompdump"
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet

######################################
# History (shared across sessions — fixes tmux panes not seeing each other)
######################################
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY          # import/append across all running shells (tmux!)
setopt INC_APPEND_HISTORY     # write each command as it runs, not on exit
setopt EXTENDED_HISTORY       # record timestamp + duration
setopt HIST_IGNORE_ALL_DUPS   # drop older duplicate of a repeated command
setopt HIST_IGNORE_SPACE      # commands starting with a space aren't recorded
setopt HIST_REDUCE_BLANKS     # tidy up whitespace
setopt HIST_VERIFY            # expand !! etc. into the line before running

######################################
# Exports
######################################
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export TERM=xterm-256color

######################################
# Tools
######################################
# mise — per-project tool versions (kubectl, k9s, etc. in dev containers).
# Stowing this .zshrc replaces any image-baked `mise activate` line, so re-add it.
command -v mise   &>/dev/null && eval "$(mise activate zsh)"
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# Kubernetes
alias k="kubectl"

# VI Mode + fzf
# bindkey -v
function zvm_after_init() {
  eval "$(fzf --zsh)"
}
[[ -f $ZSH_VI_MODE ]] && source $ZSH_VI_MODE

######################################
# Aliases
######################################
alias vim=nvim
alias ls='ls --color=auto'
alias ll='ls -la --color=auto'

setopt GLOB_DOTS
export PATH="$HOME/.local/bin:$PATH"

[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

######################################
# Plugins that must load LAST (they wrap the line editor)
######################################
[[ -f $ZSH_AUTOSUGGESTIONS ]]     && source $ZSH_AUTOSUGGESTIONS
[[ -f $ZSH_SYNTAX_HIGHLIGHTING ]] && source $ZSH_SYNTAX_HIGHLIGHTING

# Machine-specific / private overrides (untracked, e.g. work secrets)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
